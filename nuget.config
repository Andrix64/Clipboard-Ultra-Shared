<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Solo nuget.org: con la gestione centralizzata dei pacchetti più sorgenti senza mapping
       danno NU1507, e una sola sorgente nota riduce il rischio di pacchetti sostituiti. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

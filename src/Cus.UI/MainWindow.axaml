<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Cus.UI"
        x:Class="Cus.UI.MainWindow"
        Width="1268" Height="460" CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Title="CUS"
        Icon="avares://Cus.UI/Assets/cus.ico">
  <!-- Tre corpi: a sinistra cronologia e impostazioni, al centro la console, a destra rete,
       sessione e amici. I pannelli laterali si infilano dietro al corpo centrale, specchiati. -->
  <Grid Margin="14">

    <!-- Pannello sinistro: cronologia e impostazioni -->
    <Border x:Name="LeftSide" Classes="chassis" CornerRadius="5" Width="430" Height="372"
            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,30,0,0" Padding="12,12,22,12">
      <Panel>
      <ui:ChassisDecor Margin="-12,-12,-22,-12" Screws="Left" Seed="1" />
      <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <TextBlock DockPanel.Dock="Left" Text="CUS" FontSize="15" FontWeight="Black" FontStyle="Italic" Padding="0,0,4,0" Foreground="{x:Static ui:Skin.EngravingBrush}" />
          <TextBlock DockPanel.Dock="Right" Classes="engraved" Text="{ui:Tr main.memory}" VerticalAlignment="Center" />
          <ui:GripRidges Height="12" Margin="8,0,12,0" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Top">
          <Border DockPanel.Dock="Right" Classes="sticker" Margin="6,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="PASS · CLN-47" />
          </Border>
          <WrapPanel Orientation="Horizontal">
            <Button x:Name="PageHistoryButton" Classes="pill page" Content="{ui:Tr main.history}" Margin="0,0,5,0" />
            <Button x:Name="PageSettingsButton" Classes="pill page" Content="{ui:Tr main.settings}" Margin="0,0,5,0" />
            <Button x:Name="PageSimButton" Classes="pill page" Content="SIM" Margin="0,0,5,0" IsVisible="False" />
          </WrapPanel>
        </DockPanel>

        <Border Classes="lcd-dark" Margin="0,10,0,0" Padding="8">
          <Panel>
            <DockPanel x:Name="HistoryPage">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                  <Button x:Name="RefreshHistoryButton" Classes="pill" Content="{ui:Tr main.refresh}" />
                  <Button x:Name="UseHistoryButton" Classes="pill" Content="{ui:Tr main.copy}" />
                </StackPanel>
                <TextBlock x:Name="HistoryTitle" Classes="engraved" Text="{ui:Tr main.lastCopiesOnTheHostS}" VerticalAlignment="Center" />
              </DockPanel>
              <ListBox x:Name="HistoryList" Classes="lcd"
                       ToolTip.Tip="{ui:Tr main.doubleClickAnEntryToRead}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <ScrollViewer x:Name="SettingsPage" IsVisible="False">
              <StackPanel Spacing="10" Margin="0,0,6,0">
                <TextBlock Classes="engraved" Text="{ui:Tr main.thisPc}" />
                <TextBlock x:Name="IdentityText" Classes="lcd-dark" TextWrapping="Wrap" />
                <TextBlock Classes="lcd-dark" FontSize="11" TextWrapping="Wrap"
                           Text="{ui:Tr main.nameShownToOthersInitiallyThe}" />
                <DockPanel>
                  <Button x:Name="RenameButton" DockPanel.Dock="Right" Classes="pill" Content="{ui:Tr main.save}" Margin="6,0,0,0" />
                  <TextBox x:Name="NameInput" Classes="lcd" MaxLength="64" />
                </DockPanel>
                <TextBlock Classes="engraved" Text="{ui:Tr main.running}" />
                <DockPanel>
                  <Button x:Name="BackgroundToggle" DockPanel.Dock="Right" Classes="pill page" Content="SÌ" MinWidth="54" Margin="8,0,0,0" />
                  <TextBlock Classes="lcd-dark" TextWrapping="Wrap" VerticalAlignment="Center"
                             Text="{ui:Tr main.whenTheWindowIsClosedCus}" />
                </DockPanel>
                <!-- I nomi delle lingue restano nella loro lingua: si riconoscono anche senza capire l'altra. -->
                <TextBlock Classes="engraved" Text="{ui:Tr main.languageLingua}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button x:Name="LanguageItalianButton" Classes="pill page" Content="ITALIANO" />
                  <Button x:Name="LanguageEnglishButton" Classes="pill page" Content="ENGLISH" />
                </StackPanel>
                <TextBlock Classes="engraved" Text="{ui:Tr main.details}" />
                <TextBlock x:Name="InfoText" Classes="lcd-dark" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="SimPage" IsVisible="False" Spacing="8">
              <TextBlock Classes="lcd-dark" TextWrapping="Wrap"
                         Text="{ui:Tr main.virtualClipboardForTestingSeveralInstances}" />
              <DockPanel>
                <Button x:Name="SimCopyTextButton" DockPanel.Dock="Right" Classes="pill" Content="{ui:Tr main.copyText}" Margin="6,0,0,0" />
                <TextBox x:Name="SimTextInput" Classes="lcd" PlaceholderText="{ui:Tr main.textToCopy}" />
              </DockPanel>
              <WrapPanel>
                <Button x:Name="SimCopySensitiveButton" Classes="pill" Content="{ui:Tr main.copyAsPassword}" Margin="0,0,6,6" />
                <Button x:Name="SimCopyFilesButton" Classes="pill" Content="{ui:Tr main.copyFiles}" Margin="0,0,6,6" />
                <Button x:Name="SimCopyFolderButton" Classes="pill" Content="{ui:Tr main.copyFolder}" Margin="0,0,6,6" />
                <Button x:Name="SimPasteFilesButton" Classes="pill" Content="{ui:Tr main.pasteFilesInto}" Margin="0,0,6,6" />
              </WrapPanel>
              <TextBlock Classes="engraved" Text="{ui:Tr main.currentContent}" />
              <TextBlock x:Name="SimCurrentText" Classes="lcd-dark" TextWrapping="Wrap" Text="{ui:Tr common.empty}" />
            </StackPanel>
            <ui:CrtOverlay Margin="-8" Strength="0.5" />
          </Panel>
        </Border>
      </DockPanel>
      </Panel>
    </Border>

    <!-- Pannello destro: rete o sessione, e amici -->
    <Border x:Name="RightSide" Classes="chassis" CornerRadius="5" Width="430" Height="372"
            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="810,30,0,0" Padding="22,12,12,12">
      <Panel>
      <ui:ChassisDecor Margin="-22,-12,-12,-12" Screws="Right" Seed="2" />
      <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <TextBlock DockPanel.Dock="Right" Text="CUS" FontSize="15" FontWeight="Black" FontStyle="Italic" Padding="0,0,4,0" Foreground="{x:Static ui:Skin.EngravingBrush}" />
          <TextBlock DockPanel.Dock="Left" Classes="engraved" Text="{ui:Tr main.sessionControl}" VerticalAlignment="Center" />
          <ui:GripRidges Height="12" Margin="12,0,8,0" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Top">
          <TextBlock DockPanel.Dock="Right" Classes="serial" Text="47-CLN" Margin="6,0,0,0" VerticalAlignment="Center" />
          <WrapPanel Orientation="Horizontal">
            <Button x:Name="PageNetworkButton" Classes="pill page" Content="{ui:Tr common.network}" Margin="0,0,5,0" />
            <Button x:Name="PageFriendsButton" Classes="pill page" Content="{ui:Tr main.friends}" Margin="0,0,5,0" />
          </WrapPanel>
        </DockPanel>

        <Border Classes="lcd-dark" Margin="0,10,0,0" Padding="8">
          <Panel>
            <!-- Nessuna sessione: offrirsi come host o cercare in rete -->
            <DockPanel x:Name="NetworkPage">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button x:Name="OfferButton" DockPanel.Dock="Right" Classes="pill" Content="{ui:Tr main.offerAsHost}"
                        ToolTip.Tip="{ui:Tr main.youBecomeVisibleOnTheNetwork}" />
                <TextBlock Classes="engraved" Text="{ui:Tr main.hostsOnTheNetwork}" VerticalAlignment="Center" />
              </DockPanel>
              <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="AddPeerButton" DockPanel.Dock="Right" Classes="pill" Content="{ui:Tr main.save}" Margin="6,0,0,0"
                        ToolTip.Tip="{ui:Tr main.rememberTheAddressInTheList}" />
                <Button x:Name="JoinAddressButton" DockPanel.Dock="Right" Classes="pill" Content="{ui:Tr common.join}" Margin="6,0,0,0" />
                <TextBox x:Name="AddressInput" Classes="lcd" PlaceholderText="{ui:Tr main.ipOrHostNameOptionalPort}" />
              </DockPanel>
              <ScrollViewer>
                <StackPanel x:Name="PeersPanel" Spacing="4" />
              </ScrollViewer>
            </DockPanel>

            <!-- In sessione: richieste, connessi e permessi -->
            <DockPanel x:Name="SessionPage" IsVisible="False">
              <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button x:Name="VisibleToggle" Classes="pill page" Content="{ui:Tr main.visibleYes}" Margin="0,0,5,5"
                        ToolTip.Tip="{ui:Tr main.onOthersSeeYouAndCan}" />
                <Button x:Name="SensitiveToggle" Classes="pill page" Content="{ui:Tr main.passwordsToAll}" Margin="0,0,5,5"
                        ToolTip.Tip="{ui:Tr main.thisSessionOnlyThePasswordsYou}" />
                <Button x:Name="TransfersButton" Classes="pill" Content="{ui:Tr main.transfers}" Margin="0,0,5,5" IsVisible="False" />
                <Button x:Name="LeaveButton" Classes="pill danger" Content="{ui:Tr main.endSession}" Margin="0,0,5,5"
                        ToolTip.Tip="{ui:Tr main.endsTheSessionForEveryoneConnected}" />
              </WrapPanel>
              <ScrollViewer>
                <StackPanel Spacing="4">
                  <TextBlock x:Name="RequestsTitle" Classes="engraved" Text="{ui:Tr main.joinRequests}" />
                  <StackPanel x:Name="RequestsPanel" Spacing="4" />
                  <TextBlock Classes="engraved" Text="{ui:Tr main.connected}" Margin="0,6,0,0" />
                  <StackPanel x:Name="ParticipantsPanel" Spacing="4" />
                </StackPanel>
              </ScrollViewer>
            </DockPanel>

            <!-- Amici: patti reciproci e fiducia per i contenuti sensibili -->
            <DockPanel x:Name="FriendsPage" IsVisible="False">
              <TextBlock x:Name="FriendsHint" DockPanel.Dock="Top" Classes="lcd-dark" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
              <ScrollViewer>
                <StackPanel x:Name="FriendsPanel" Spacing="4" />
              </ScrollViewer>
            </DockPanel>
            <ui:CrtOverlay Margin="-8" Strength="0.5" />
          </Panel>
        </Border>
      </DockPanel>
      </Panel>
    </Border>

    <!-- Corpo centrale: la console -->
    <Border x:Name="Deck" Classes="chassis" Width="404" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="418,0,0,0" Padding="16,12,16,16">
      <Panel>
      <ui:ChassisDecor Margin="-16,-12,-16,-16" Screws="Both" Seed="3" CornerRadius="6" />
      <DockPanel>
        <DockPanel x:Name="DragBar" DockPanel.Dock="Top" Background="Transparent" Height="28">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <ui:Lamp Width="16" Height="16" Color="#FF3B2B" Pulse="True" Margin="0,0,2,0" />
            <ui:Lamp Width="16" Height="16" Color="#E8EEF2" Margin="0,0,4,0" />
            <Button x:Name="MinimizeButton" AutomationProperties.Name="{ui:Tr main.minimize}" Classes="round small" ToolTip.Tip="{ui:Tr main.minimize2}" />
            <Button x:Name="CloseButton" AutomationProperties.Name="{ui:Tr main.close}" Classes="round small" ToolTip.Tip="{ui:Tr main.closeTheWindow}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="CUS" FontSize="22" FontWeight="Black" FontStyle="Italic" Padding="0,0,5,0" Foreground="{x:Static ui:Skin.LimeTextBrush}" />
            <TextBlock Classes="engraved" Text="CLIPBOARD · ULTRA · SHARED" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>

        <Border x:Name="LcdPanel" Classes="lcd" DockPanel.Dock="Top" Margin="0,10,0,0" Height="196" Padding="14,10">
          <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
            <DockPanel>
              <TextBlock x:Name="LcdPort" DockPanel.Dock="Right" Classes="lcd" FontSize="11" />
              <TextBlock x:Name="LcdDevice" Classes="lcd" FontSize="11" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock x:Name="LcdState" Grid.Row="1" Classes="lcd" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" Text="{ui:Tr common.waiting}" />
            <TextBlock x:Name="LcdParticipants" Grid.Row="2" Classes="lcd" FontSize="12" TextTrimming="CharacterEllipsis" />
            <DockPanel Grid.Row="3">
              <TextBlock x:Name="LcdCurrentSize" DockPanel.Dock="Right" Classes="lcd" FontSize="12" FontWeight="Bold" Margin="8,0,0,0" />
              <TextBlock x:Name="LcdCurrent" Classes="lcd" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock x:Name="LcdLast" Grid.Row="4" Classes="lcd" FontSize="11" TextTrimming="CharacterEllipsis" />
            <ui:CrtOverlay x:Name="LcdRadar" Grid.RowSpan="5" Margin="-14,-10" Radar="True" CornerRadius="8" Strength="0.8" />
          </Grid>
        </Border>

        <Border x:Name="StartupErrorPanel" DockPanel.Dock="Top" IsVisible="False" Classes="lcd-dark" Margin="0,8,0,0" Padding="10">
          <TextBlock x:Name="StartupErrorText" Classes="lcd-dark" Foreground="{x:Static ui:Skin.AlertBrush}" TextWrapping="Wrap" />
        </Border>

        <Panel Margin="0,10,0,0">
          <ListBox x:Name="ActivityList" Classes="lcd" FontSize="11">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ui:CrtOverlay CornerRadius="6" Strength="0.5" />
        </Panel>
      </DockPanel>
      <ui:LedStrip HorizontalAlignment="Left" VerticalAlignment="Top" Width="8" Height="184" Margin="-12,44,0,0" />
      <ui:LedStrip HorizontalAlignment="Right" VerticalAlignment="Top" Width="8" Height="184" Margin="0,44,-12,0" />
      </Panel>
    </Border>
  </Grid>
</Window>

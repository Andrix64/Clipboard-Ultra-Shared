<Project Sdk="Microsoft.NET.Sdk">

  <!-- Interfaccia Avalonia, multipiattaforma. Non referenzia nessun progetto di piattaforma:
       riceve i servizi dal progetto eseguibile. -->
  <PropertyGroup>
    <RootNamespace>Cus.UI</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icona dell'app (telaio metallico + LCD lime, vedi Skin.cs): la usano le finestre via avares://
         e Cus.App.Windows come icona dell'eseguibile. -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cus.Core\Cus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loc.T("italiano", "english") ovunque senza using. -->
    <Using Include="Cus.Core.Localization" />
  </ItemGroup>

</Project>

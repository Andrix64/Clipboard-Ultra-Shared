<Project Sdk="Microsoft.NET.Sdk">

  <!-- Eseguibile Windows: fornisce le parti Windows (WindowsPlatform) all'avvio comune di
       Cus.App.Shared, che legge le opzioni, sceglie le implementazioni e avvia la UI. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>Cus.App.Windows</RootNamespace>
    <AssemblyName>cus</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Cus.UI\Assets\cus.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cus.Core\Cus.Core.csproj" />
    <ProjectReference Include="..\Cus.UI\Cus.UI.csproj" />
    <ProjectReference Include="..\Cus.App.Shared\Cus.App.Shared.csproj" />
    <ProjectReference Include="..\Cus.Platform.Windows\Cus.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loc.T("italiano", "english") ovunque senza using. -->
    <Using Include="Cus.Core.Localization" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Nucleo indipendente dalla piattaforma: niente API di Windows, niente #if WINDOWS.
       Le parti native passano dalle interfacce in Abstractions/. -->
  <PropertyGroup>
    <RootNamespace>Cus.Core</RootNamespace>
    <!-- Necessario per [LibraryImport] verso libsodium. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" />
    <PackageReference Include="libsodium" />
  </ItemGroup>

  <ItemGroup>
    <!-- Una lingua per file (codice.json): per aggiungerne una basta un file nuovo qui (vedi Loc.cs). -->
    <EmbeddedResource Include="Localization\Languages\*.json" LogicalName="Cus.Core.Localization.Languages.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cus.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loc.T("italiano", "english") ovunque senza using. -->
    <Using Include="Cus.Core.Localization" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Eseguibile Linux: come Cus.App.Windows legge le opzioni da riga di comando, sceglie le
       implementazioni (Linux reali o simulate) e avvia la UI. Richiede una sessione X11 o XWayland. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Cus.App.Linux</RootNamespace>
    <AssemblyName>cus</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cus.Core\Cus.Core.csproj" />
    <ProjectReference Include="..\Cus.UI\Cus.UI.csproj" />
    <ProjectReference Include="..\Cus.Platform.Linux\Cus.Platform.Linux.csproj" />
    <ProjectReference Include="..\Cus.Platform.Simulated\Cus.Platform.Simulated.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loc.T("italiano", "english") ovunque senza using. -->
    <Using Include="Cus.Core.Localization" />
  </ItemGroup>

</Project>
